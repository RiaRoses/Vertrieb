# Node >=22. Im lokalen Entwicklungsbetrieb reicht: npm run dev
HOST=127.0.0.1
PORT=3000
# Optional: persistentes Verzeichnis für verschlüsselte Browser-Sitzungen.
# DATA_DIR=/persist/vertrieb
# Bei HTTPS hinter einem Reverse Proxy zwingend passend setzen:
# APP_ORIGIN=https://vertrieb.example.com
# COOKIE_SECURE=true
# Bei Containerbetrieb ggf. HOST=0.0.0.0 setzen.
# Notion- und OpenAI-Schlüssel werden in der App eingegeben, nicht hier.
